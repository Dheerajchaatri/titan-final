datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CANDIDATE
  EMPLOYER
  ADMIN
}

enum ApplicationStatus {
  UNDER_REVIEW
  SHORTLISTED
  INTERVIEW_SCHEDULED
  OFFER_RECEIVED
  REJECTED
}

model User {
  id               String            @id @default(uuid())
  email            String            @unique
  name             String
  role             Role              @default(CANDIDATE)
  avatarUrl        String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  candidateProfile CandidateProfile?
  employerProfile  EmployerProfile?
}

model CandidateProfile {
  id                   String           @id @default(uuid())
  userId               String           @unique
  user                 User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title                String
  location             String
  experienceYears      Float
  availability         String
  preferredSalary      String
  preferredCities      String[]
  jobType              String
  aboutMe              String
  phone                String
  age                  Int
  profileCompletion    Int              @default(0)
  aiEmployabilityScore Int              @default(0)
  skills               Skill[]
  experience           Experience[]
  education            Education[]
  certificates         Certificate[]
  projects             Project[]
  languages            Language[]
  applications         JobApplication[]
}

model Skill {
  id                 String           @id @default(uuid())
  candidateProfileId String
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)
  name               String
  rating             Int              @default(50)
}

model Experience {
  id                 String           @id @default(uuid())
  candidateProfileId String
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)
  role               String
  company            String
  location           String
  period             String
  description        String[]
}

model Education {
  id                 String           @id @default(uuid())
  candidateProfileId String
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)
  degree             String
  school             String
  period             String
  grade              String
}

model Certificate {
  id                 String           @id @default(uuid())
  candidateProfileId String
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)
  name               String
  issuer             String
  year               String
}

model Project {
  id                 String           @id @default(uuid())
  candidateProfileId String
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)
  name               String
  description        String
  tech               String[]
  link               String?
}

model Language {
  id                 String           @id @default(uuid())
  candidateProfileId String
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)
  name               String
  level              String
  rating             Int
}

model EmployerProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName String
  industry    String
  employees   String
  location    String
  website     String
  about       String
  logo        String
  founded     String
  jobs        Job[]
}

model Job {
  id                 String           @id @default(uuid())
  employerProfileId  String
  employerProfile    EmployerProfile  @relation(fields: [employerProfileId], references: [id], onDelete: Cascade)
  title              String
  companyName        String
  industry           String
  logo               String
  location           String
  salaryRange        String
  jobType            String
  experienceRequired String
  description        String
  requirements       String[]
  benefits           String[]
  isFeatured         Boolean          @default(false)
  createdAt          DateTime         @default(now())
  applications       JobApplication[]
}

model JobApplication {
  id                 String            @id @default(uuid())
  jobId              String
  job                Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidateProfileId String
  candidateProfile   CandidateProfile  @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)
  status             ApplicationStatus @default(UNDER_REVIEW)
  appliedDate        DateTime          @default(now())
  cvUrl              String
  coverLetter        String?
  matchScore         Int
}
